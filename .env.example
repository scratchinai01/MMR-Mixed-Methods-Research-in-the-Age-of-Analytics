# 複製本檔為 .env（或在部署平台的環境變數設定），填入自己的金鑰
# 金鑰只放在伺服器端，瀏覽器端看不到

# Groq（優先使用的 AI）：https://console.groq.com/keys
GROQ_API_KEY=
# 可選：指定模型；留空則用 openai/gpt-oss-120b，失敗時改用 llama-3.3-70b-versatile
GROQ_MODEL=

# Gemini（Groq 失敗時的備援；上傳 PDF 時優先使用）：https://aistudio.google.com/apikey
GEMINI_API_KEY=

# FinMind（台股新聞與股價）：https://finmindtrade.com/ 登入後取得 Token
FINMIND_API_TOKEN=

# 可選：伺服器埠號（預設 3000）
PORT=
