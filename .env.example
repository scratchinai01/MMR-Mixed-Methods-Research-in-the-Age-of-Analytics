# 複製本檔為 .env（或在部署平台／AI Studio Secrets 設定），填入自己的金鑰
# 金鑰只放在伺服器端，瀏覽器端看不到

# Groq（優先使用的 AI）：https://console.groq.com/keys
GROQ_API_KEY=
# 可選：多把金鑰輪替（逗號分隔），某把額度用盡 (429) 會自動換下一把
GROQ_API_KEYS=
# 可選：指定模型；留空則用 openai/gpt-oss-120b，失敗時改用 llama-3.3-70b-versatile
GROQ_MODEL=

# Gemini（Groq 失敗時的備援；上傳 PDF 時優先使用）：https://aistudio.google.com/apikey
GEMINI_API_KEY=

# FinMind（台股新聞與股價）：https://finmindtrade.com/ 登入後取得 Token
# 設在伺服器端後，所有訪客都能使用真實資料，不必各自輸入
FINMIND_API_TOKEN=

# 可選：伺服器埠號（預設 3000）；AI Studio 會自動注入 APP_URL
PORT=
APP_URL=
