# 複製本檔為 .env（或在部署平台／AI Studio Secrets 設定），填入自己的金鑰
# 金鑰只放在伺服器端，瀏覽器端看不到

# Gemini（翻譯、解析、新聞情緒判讀）：https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 可選：模型與思考程度（不設定就用以下最省成本的預設值）
#   翻譯、情緒判讀：gemini-3.1-flash-lite，思考 MINIMAL
#   學術解析：gemini-3.1-flash-lite，思考 LOW（想要更深入可改 gemini-3.8-flash，費用較高）
GEMINI_TRANSLATE_MODEL=
GEMINI_ANALYSIS_MODEL=
GEMINI_ANALYSIS_THINKING=

# FinMind（台股新聞與股價）：https://finmindtrade.com/ 登入後取得 Token
# 設在伺服器端後，所有訪客都能使用真實資料，不必各自輸入
FINMIND_API_TOKEN=

# 可選：伺服器埠號（預設 3000）；AI Studio 會自動注入 APP_URL
PORT=
APP_URL=
